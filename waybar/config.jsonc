// -*- mode: jsonc -*-
{
    "layer": "top",
    "position": "top",
    "height": 38,
    "spacing": 0,

    "modules-left": [
        "niri/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "tray",
        "backlight",
        "pulseaudio",
        "network",
        "clock#date",
        "custom/battery"
    ],

    "niri/workspaces": {
        "format": "{value}"
    },

    "custom/battery": {
        "exec": "~/.config/waybar/scripts/battery.sh",
        "return-type": "json",
        "interval": 5
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip": false
    },

    "clock#date": {
        "format": "{:%m/%d %a}",
        "tooltip-format": "<big>{:%Y年 %m月 %d日}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "backlight": {
        "format": "{icon}",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "tooltip-format": "Brightness: {percent}%",
        "scroll-step": 5
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰖁",
        "format-icons": {
            "headphone": "󰋋",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "tooltip-format": "{desc}: {volume}%",
        "scroll-step": 5
    },

    "network": {
        "interface": "wl*",
        "format-wifi": "{icon}",
        "format-disconnected": "󰤮",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format-wifi": "{essid}  {signalStrength}%\n{ipaddr}/{cidr}",
        "tooltip-format-disconnected": "Wi-Fi disconnected",
        "on-click": "~/.config/waybar/scripts/wifi-menu.sh"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    }
}
