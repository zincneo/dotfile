layout {
    default_tab_template {
        pane size=1 borderless=true default_bg="#1E2030" {
            plugin location="file:/home/zinc/dotfile/zellij/plugins/zjstatus.wasm" {
                color_bg      "#1E2030"
                color_fg      "#CAD3F5"
                color_dim     "#6E738D"
                color_blue    "#8AADF4"
                color_green   "#A6DA95"
                color_yellow  "#EED49F"
                color_red     "#ED8796"
                color_mauve   "#C6A0F6"
                color_peach   "#F5A97F"
                color_teal    "#8BD5CA"
                color_sky     "#91D7E3"
                color_sapphire "#7DC4E4"
                color_lavender "#B7BDF8"
                color_pink    "#F5BDE6"

                format_left   "#[fg=$blue,bg=$bg,bold] {mode} #[fg=$fg,bg=$bg][{session}]"
                format_center "#[fg=$fg,bg=$bg]{tabs}"
                format_right  "#[fg=$green,bg=$bg]{command_git_branch}"
                format_space  "#[bg=$bg]"

                border_enabled            "false"
                hide_frame_for_single_pane "false"

                mode_normal       "#[fg=$green,bg=$bg,bold]{name}"
                mode_locked       "#[fg=$lavender,bg=$bg,bold]{name}"
                mode_resize       "#[fg=$peach,bg=$bg,bold]{name} "
                mode_pane         "#[fg=$blue,bg=$bg,bold]{name}"
                mode_tab          "#[fg=$mauve,bg=$bg,bold]{name}"
                mode_scroll       "#[fg=$teal,bg=$bg,bold]{name}"
                mode_enter_search "#[fg=$sky,bg=$bg,bold]{name}"
                mode_search       "#[fg=$sky,bg=$bg,bold]{name}"
                mode_rename_tab   "#[fg=$yellow,bg=$bg,bold]{name}"
                mode_rename_pane  "#[fg=$yellow,bg=$bg,bold]{name}"
                mode_session      "#[fg=$sapphire,bg=$bg,bold]{name}"
                mode_move         "#[fg=$pink,bg=$bg,bold]{name}"
                mode_prompt       "#[fg=$red,bg=$bg,bold]{name}"
                mode_tmux         "#[fg=$peach,bg=$bg,bold]{name}"

                tab_normal "#[fg=$dim,bg=$bg]{name}"
                tab_active "#[fg=$red,bg=$bg,bold]{name}:#[fg=$green,bg=$bg]{focused_pane_title}"

                command_git_branch_command    "git rev-parse --abbrev-ref HEAD"
                command_git_branch_format     "#[fg=$green,bg=$bg] {stdout}"
                command_git_branch_interval   "10"
                command_git_branch_rendermode "static"
                command_git_branch_cwd        "{focused_pane_cwd}"
            }
        }
        children
    }
}
