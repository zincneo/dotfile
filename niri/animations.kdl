animations {
    // off

    workspace-switch {
        spring damping-ratio=0.8 stiffness=400 epsilon=0.0001
    }

    window-open {
        duration-ms 150
        curve "ease-out-expo"
    }

    window-close {
        duration-ms 150
        curve "ease-out-quad"
    }

    window-movement {
        spring damping-ratio=0.6 stiffness=200 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=0.6 stiffness=400 epsilon=0.0001
    }

    horizontal-view-movement {
        spring damping-ratio=0.8 stiffness=200 epsilon=0.0001
    }

    screenshot-ui-open {
        duration-ms 200
        curve "ease-out-quad"
    }
}
